# Copy to app.env and fill in. Never commit app.env.

APP_ENV=production
LOG_LEVEL=info

POSTGRES_DB=trezutil
POSTGRES_USER=trezutil
POSTGRES_PASSWORD=
# Use "require" (or stronger) when PostgreSQL is not on the private compose network.
POSTGRES_SSLMODE=disable

# Signing secret for all access/refresh tokens. 32+ random characters, e.g.
#   openssl rand -base64 48
JWT_SECRET=
# REQUIRED separate key for OTP code hashing: 32+ random characters, different from JWT_SECRET.
OTP_CODE_SECRET=

# REQUIRED: public origin(s) of the web app (comma separated). Never "*"; no default.
CORS_ALLOWED_ORIGINS=
GATEWAY_PUBLISH=8080
# VPS shared with Odoo (docker-compose.vps.yml): the gateway listens on 127.0.0.1 at this port only, behind the host's
# nginx (deployments/nginx/trezutil.conf). Never 80, 443, 5432, 8069 or 8072.
GATEWAY_LOCAL_PORT=18080
# Number of reverse proxies in front of the gateway (1 behind Caddy/nginx/Traefik, 0 if exposed directly).
TRUSTED_PROXY_HOPS=1
# TLS proxy (docker-compose.proxy.yml): the public domain (its DNS record must point at this host), a mailbox
# that Let's Encrypt can reach, and who may reach the administration console (addresses or ranges,
# space-separated; empty means nobody).
PUBLIC_HOST=
ACME_EMAIL=
ADMIN_ALLOW_IPS=
# Alert destinations (docker-compose.monitoring.yml): web addresses that alerts are posted to, one for what
# is urgent and one for what can wait for the day. They carry a token: keep them secret.
ALERT_WEBHOOK_PAGE_URL=
ALERT_WEBHOOK_TICKET_URL=
# Content-Security-Policy of the web app: report-only (default), enforce or off. Watch the logs for
# event=csp_violation while in report-only, then switch to enforce.
CSP_MODE=report-only
# Bearer token for GET /metrics on the gateway and for the monitoring overlay. Generate: openssl rand -base64 32
METRICS_TOKEN=

# WhatsApp Cloud API (required for OTP delivery and WhatsApp conversations in production)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved "authentication" template name for sign-in codes (needed outside the 24h window)
WHATSAPP_OTP_TEMPLATE=
# Its language code exactly as approved by Meta (fr, en, fr_FR…)
WHATSAPP_OTP_TEMPLATE_LANG=en

# Stripe (card payments). Keys are referenced from the organization's
# 'stripe' providers row; see docs/finalization/PRODUCTION_DEPLOYMENT.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=

# AI intent classification (optional; keyword routing when AI_PROVIDER is empty).
# One provider (anthropic | gemini) or a priority list such as gemini,anthropic: a call goes to the
# first provider and, if it fails (no credit, rate limit, outage), to the next.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30

# Web build (public values baked into the SPA at image build time).
# The number of the WhatsApp Business account, digits only, with the country code.
# It drives the site's WhatsApp button; leave it empty and the button is not shown.
# Rebuild the image after changing it: docker compose ... up -d --build
VITE_WHATSAPP_NUMBER=
# The public pages of the mobile app on the Play Store and the App Store (full https addresses).
# The footer says "Available on WhatsApp, PlayStore and AppStore" using only what is set here:
# a store left empty is not mentioned, and the WhatsApp QR code needs the number above.
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
# "true" shows placeholders for the channels above that are not connected yet (the footer line, a QR code frame,
# the WhatsApp section), so the layout can be seen before the real values exist. Staging only: in production
# leave it empty, and a channel that does not exist is never mentioned.
VITE_CHANNEL_PLACEHOLDERS=
# The label shown beside the portal switcher in the administration ("staging", "demo"…).
# Leave it empty, or set "production", on the live site: nothing is shown.
VITE_APP_ENV=


# Language of the assistant when a channel sends none (WhatsApp). The web app sends the interface language.
DEFAULT_LANGUAGE=fr

# Sign in with Google: OAuth client id of a "Web application" client (Google Cloud Console -> APIs & Services
# -> Credentials). Public value, no secret needed. Authorized JavaScript origin: https://trezutil.com
GOOGLE_CLIENT_ID=
