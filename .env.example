# Local development defaults. Copy to .env (never commit real secrets).
# Production: see deployments/docker/app.env.example and docs/finalization/PRODUCTION_READINESS.md.

APP_ENV=development            # development enables dev-only conveniences (OTP codes logged, default DATABASE_URL)
LOG_LEVEL=info

# PostgreSQL (authoritative store). Required outside development.
DATABASE_URL=postgres://trezutil:trezutil@localhost:5432/trezutil?sslmode=disable
MIGRATIONS_DIR=./migrations

# Authentication (shared by every service). 32+ random characters.
JWT_SECRET=
JWT_ISSUER=trezutil
JWT_AUDIENCE=trezutil-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
OTP_CODE_SECRET=               # optional; defaults to a derivation of JWT_SECRET
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_10MIN=20

# OpenSearch (read projection)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=trezutil-listings-v1
OPENSEARCH_ALIAS=trezutil-listings
OPENSEARCH_TIMEOUT=30s
OPENSEARCH_TLS=false
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_REINDEX_BATCH=1000
SEARCH_SYNC_INTERVAL=5s
SEARCH_FULL_RESYNC_INTERVAL=1h

# Gateway (only public port) and upstreams
GATEWAY_PORT=:8080
WEB_ROOT=./web/frontend/dist
CORS_ALLOWED_ORIGINS=http://localhost:8080
IDENTITY_SERVICE_URL=http://127.0.0.1:8086
SEARCH_SERVICE_URL=http://127.0.0.1:8081
CONVERSATION_SERVICE_URL=http://127.0.0.1:8091
COMMERCE_SERVICE_URL=http://127.0.0.1:8085
PAYMENT_SERVICE_URL=http://127.0.0.1:8083

# WhatsApp Cloud API (OTP delivery + WhatsApp channel)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=           # webhook HMAC (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=         # webhook subscription handshake
WHATSAPP_OTP_TEMPLATE=         # approved authentication template name
WHATSAPP_OTP_TEMPLATE_LANG=en

# AI intent classification through the AI gateway. Empty = deterministic
# keyword routing. "anthropic" uses the Anthropic Messages API.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low                  # low | medium | high
AI_TIMEOUT_SECONDS=30          # whole call incl. retries
AI_REQUEST_TIMEOUT_SECONDS=15  # per HTTP attempt
AI_MAX_RETRIES=2
AI_BASE_URL=                   # optional proxy / emulator

# Stripe card payments: referenced by the organization's 'stripe' providers row
# (secret_ref=env:STRIPE_SECRET_KEY, webhook_secret_ref=env:STRIPE_WEBHOOK_SECRET)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYMENT_PROVIDER_REFRESH_SECONDS=60

# Web app (Vite, build time, public): WhatsApp Business number for "Chat on WhatsApp"
VITE_WHATSAPP_NUMBER=

# Optional infrastructure not used by the MVP services
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9092
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=trezutil
